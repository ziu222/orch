{
  "name": "orch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local multi-agent orchestrator driving official vendor CLIs",
  "bin": { "orch": "src/cli.ts" },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "ui": "node src/cli.ts ui",
    "ui:install": "npm --prefix ui install",
    "ui:build": "npm --prefix ui run build",
    "ui:dev": "npm --prefix ui run dev",
    "demo": "node scripts/seed-demo.ts"
  },
  "engines": { "node": ">=23.6" }
}
